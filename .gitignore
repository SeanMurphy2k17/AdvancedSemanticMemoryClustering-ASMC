# Python
__pycache__/
*.pyc
*.pyo

# A store is one machine's memory: it stays out of version control, so pulling on
# another machine can never overwrite that machine's memories. The word cache's
# data file is the exception: it ships with the library on purpose.
V2/MemoryStructures/*
!V2/MemoryStructures/word_cache.lmdb/
V2/MemoryStructures/word_cache.lmdb/lock.mdb

# Test data / editor state
*.pdf
imgui.ini

# More runtime state (2026-11): per-platform cursors, atomic-write temp files, local backups
V2/.orig-*/

# The entity's own files, beside the store: private, never in this public repo
V2/journal.md
V2/mood.json
V2/name.json
V2/PAUSE
